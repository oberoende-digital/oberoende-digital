# Local/runtime RAG artifacts
# Raw PDFs and extracted sidecar text are downloaded to the server but are too
# large/noisy for normal GitHub commits. Keep the script + metadata in git.
data/rag/pdf_sources/
data/rag/*.sqlite3-shm
data/rag/*.sqlite3-wal
server/*.sqlite3
server/*.sqlite3-shm
server/*.sqlite3-wal

# Local backend runtime data
data/backend/*.sqlite3
data/backend/*.sqlite3-*
data/backend/*.json

# Python caches
__pycache__/
*.py[cod]

# macOS
.DS_Store

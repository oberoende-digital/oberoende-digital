# Oberoende Digital backend local configuration
OD_ENV=local
OD_BACKEND_DB=data/backend/od_backend.sqlite3
OD_LLM_PROVIDER=disabled
OD_SYNTHETIC_DISCLOSURE="AI-generated synthetic OD agent response; human operator remains accountable."

# Required for Discord REST validation. Do not commit real secrets.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Allowlist one monitored Discord channel. talk-to-od-ai = 1509855875102277652.
OD_DISCORD_MONITOR_CHANNEL_ID=1509855875102277652

# Stable local secret for pseudonymizing Discord user IDs in audit logs.
# Set a private random value in real deployments; do not commit it.
OD_RETENTION_HASH_SECRET=change-me-local-dev-only

# Extra gate for future live posting. Leave false unless a human operator explicitly approves a live-post test.
OD_DISCORD_LIVE_POST_ENABLED=false
